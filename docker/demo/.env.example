# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，勿提交）
# 也可以不建 .env，直接在 demo 页面「密钥配置」面板里填写（仅存服务端内存）

# --- 模型密钥：demo 派活（POST /chat）时注入容器使用 ---
DEEPSEEK_API_KEY=sk-xxxx

# --- 阿里云 ACR 凭据：Sealos 拉取私有镜像 eftik/eftik-dsh-cloud 用 ---
ACR_USER=your-acr-username
ACR_PASS=your-acr-password

# --- Sealos 集群凭据：demo-server 创建/查询/删除工作台容器 ---
# 相对路径相对本 demo 目录；kubeconfig 含集群凭据，已 gitignore
SEALOS_KUBECONFIG_PATH=kubeconfig.yaml

# --- 工作台容器镜像（网关 v0.5 代码构建出的 1.3.0 版，可选，不设用默认值）---
# DSH_IMAGE=registry.cn-shanghai.aliyuncs.com/eftik/eftik-dsh-cloud:1.3.0

# --- 产品模式（可选；见 gateway.js 的 PRODUCT_MODE 注释块）---
# 开启后创建的容器：用户侧锁沙箱(workspace-write)、平台预设隐藏、模型前导保密；
# 不设则容器网关完全开放（v0.3 行为，纯联调）。
# GW_PRODUCT_MODE=1
# 平台管理令牌：demo-server 以平台身份调 /settings 时携带 X-GW-Admin 头
# （容器网关校验此值，持有者可读写全部字段含预设；容器内用户拿不到）
# GW_ADMIN_TOKEN=平台管理令牌
# 平台预设人设背景：任务前导注入 <system-context>，用户 GET 不可见、POST 不可改
# GW_PRESET_BACKGROUND=平台预设角色背景
# 平台预设记忆：同上，仅平台（X-GW-Admin）可读写
# GW_PRESET_MEMORY=平台预设记忆
